APP_NAME=Interview Loom
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=3600
LOG_LEVEL=INFO

# Локальная транскрибация. Значение auto включает автоматическое определение языка.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_NORMALIZE_AUDIO=true
WHISPER_MODEL_DIR=./data/models

# AI-анализ. Никогда не добавляйте реальный ключ в Git.
GEMINI_API_KEY=
# auto selects a generateContent model available to the current key.
GEMINI_MODEL=auto
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRY_ATTEMPTS=3
